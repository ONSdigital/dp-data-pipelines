{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "metadata_file": {
      "type": "string"
    },
    "submission_contacts": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            }
          },
          "required": [
            "email"
          ]
        }
      ]
    },
    "use_previous_metadata": {
      "type": "boolean"
    }
  },
  "required": [
    "metadata_file",
    "submission_contacts",
    "use_previous_metadata"
  ]
}